# ==============================================================================
# BK Galabovo 2025 - Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC CONFIGURATION (Safe for browser bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_ID="bkgalabovo"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourPublicApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="bkgalabovo2025.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="bkgalabovo2025"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="bkgalabovo2025.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Set to "true" only when testing against local Firebase Emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="false"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER ADD NEXT_PUBLIC_ PREFIX!)
# ------------------------------------------------------------------------------

# Option A: Full JSON Service Account (Recommended for Vercel / Production)
# Single line or properly escaped JSON string
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"bkgalabovo2025","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@bkgalabovo2025.iam.gserviceaccount.com"}'

# Option B: Individual Service Account Fields (Alternative)
FIREBASE_PROJECT_ID="bkgalabovo2025"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@bkgalabovo2025.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. CRON & BACKGROUND WORKERS SECURITY
# ------------------------------------------------------------------------------
# Required for securing /api/cron/* and /api/send-email internal calls
CRON_SECRET="your-strong-random-cron-secret-token"

# ------------------------------------------------------------------------------
# 4. EMAIL & NOTIFICATIONS DISPATCH
# ------------------------------------------------------------------------------
EMAIL_USER="notifications@bkgalabovo.com"
EMAIL_PASS="your-email-app-password"
ADMIN_ARCHIVE_EMAIL="bkgalabovo2014@gmail.com"

# Optional SMTP Host settings (if using standard SMTP transporter)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@bkgalabovo.com"
SMTP_PASS="your-email-app-password"
