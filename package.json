{
  "name": "nextn",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --config stylelint.config.cjs",
    "lint:css:fix": "stylelint \"src/**/*.css\" --config stylelint.config.cjs --fix",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules .next package-lock.json",
    "analyze": "cross-env ANALYZE=true npm run build",
    "check-licenses": "license-checker-evergreen --summary",
    "postinstall": "patch-package",
    "deps:update": "ncu -u",
    "lighthouse": "node scripts/lighthouse-audit.js",
    "icons:generate": "node scripts/generate-icons.js",
    "check:circular": "madge --circular --extensions ts,tsx src",
    "check:deps": "dependency-cruiser src",
    "check:dup-code": "jscpd src",
    "check:dup-funcs": "find-duplicate src",
    "test:e2e": "playwright test",
    "test:visual": "playwright test visual.spec.ts",
    "check-all": "npm run typecheck && npm run lint && npm run check:circular && npm run check:deps && npm run check:dup-code && npm run check:dup-funcs && npm run test && npm run test:visual",
    "check-fast": "npm run typecheck && npm run lint && npm run test",
    "test": "vitest run",
    "security-check": "npm audit",
    "prepare": "husky",
    "precommit": "lint-staged",
    "migrate:bkgalabovo": "tsx scripts/migrate-bkgalabovo-site-id.ts",
    "migrate:recoveryzone": "tsx scripts/import-recovery-zone.ts",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules --project bkgalabovo2025",
    "deploy:indexes": "npx -y firebase-tools@latest deploy --only firestore:indexes --project bkgalabovo2025"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.7",
    "patch-package": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.6",
    "react-email": "^6.1.1",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.6",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.7.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.7",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "find-duplicate-js": "^1.7.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "jsdom": "^29.1.1",
    "knip": "^6.12.2",
    "license-checker-evergreen": "^6.2.1",
    "lint-staged": "^17.0.8",
    "madge": "^8.0.0",
    "npm-check-updates": "^22.2.0",
    "postcss": "^8.5.14",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.5",
    "@tootallnate/once": "^3.0.1",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.4.15",
    "glob": "^13.0.6",
    "@radix-ui/react-primitive": "2.1.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
