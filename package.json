{
  "name": "nextn",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache",
    "lint:css": "stylelint \"src/**/*.css\" --config stylelint.config.cjs",
    "lint:css:fix": "stylelint \"src/**/*.css\" --config stylelint.config.cjs --fix",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules .next package-lock.json",
    "clean:artifacts": "rimraf .next storybook-static playwright-report test-results .lighthouse-reports",
    "analyze": "cross-env ANALYZE=true npm run build",
    "check-licenses": "license-checker-evergreen --summary",
    "postinstall": "patch-package",
    "deps:update": "ncu -u",
    "lighthouse": "node scripts/lighthouse-audit.js",
    "lighthouse:gate": "node scripts/lighthouse-gate.js",
    "lighthouse:all": "node scripts/lighthouse-audit.js --limit=100",
    "icons:generate": "node scripts/generate-icons.js",
    "check:circular": "madge --circular --extensions ts,tsx src",
    "check:deps": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "check:dup-code": "jscpd src",
    "check:dup-funcs": "find-duplicate src",
    "test:e2e": "firebase emulators:exec \"playwright test --ignore-snapshots\" --project bkgalabovo-test",
    "test:visual": "playwright test visual.spec.ts",
    "check-all": "npm run typecheck && npm run lint && npm run check:deps && npm run check:circular && npm run check:dup-code && npm run check:dup-funcs && npm run test && npm run knip && npm run security-check",
    "test": "vitest run",
    "test:rules": "cross-env TEST_ENV=rules firebase emulators:exec \"vitest run src/__tests__/firestore.rules.test.ts\" --project bkgalabovo-test",
    "test:integration": "cross-env TEST_ENV=integration firebase emulators:exec \"vitest run src/integration-tests\" --project bkgalabovo-test",
    "security-check": "npm audit --audit-level=critical --omit=dev",
    "prepare": "husky",
    "precommit": "lint-staged",
    "migrate:bkgalabovo": "tsx scripts/migrate-bkgalabovo-site-id.ts",
    "migrate:recoveryzone": "tsx scripts/import-recovery-zone.ts",
    "migrate:recovery-reviews": "tsx scripts/migrate-recovery-reviews.ts",
    "migrate:siteid:dry": "tsx scripts/migrate-siteid-legacy.ts --dry-run",
    "migrate:siteid": "tsx scripts/migrate-siteid-legacy.ts",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules --project bkgalabovo2025",
    "deploy:indexes": "npx -y firebase-tools@latest deploy --only firestore:indexes --project bkgalabovo2025",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/render": "^2.1.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "patch-package": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-email": "^6.9.5",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.6.1",
    "react-is": "^19.3.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.9.7",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "find-duplicate-js": "^1.11.0",
    "firebase-tools": "^15.30.1",
    "husky": "^9.1.7",
    "jscpd": "^5.2.1",
    "jsdom": "^29.1.1",
    "knip": "^6.36.0",
    "license-checker-evergreen": "^6.3.1",
    "lint-staged": "^17.5.1",
    "madge": "^8.0.0",
    "npm-check-updates": "^22.2.9",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.7",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "storybook": "10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.5",
    "@tootallnate/once": "^3.0.1",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.4.15",
    "glob": "^13.0.6",
    "@radix-ui/react-primitive": "2.1.3"
  },
  "allowScripts": {
    "@firebase/util": true,
    "core-js": true,
    "core-js-pure": true,
    "esbuild": true,
    "protobufjs": true,
    "re2": true,
    "tesseract.js": true,
    "unrs-resolver": true
  },
  "lavamoat": {
    "allowScripts": {
      "@firebase/util": true,
      "core-js": true,
      "core-js-pure": true,
      "esbuild": true,
      "protobufjs": true,
      "re2": true,
      "tesseract.js": true,
      "unrs-resolver": true
    }
  }
}
