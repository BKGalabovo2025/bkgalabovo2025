rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper Functions --
    function isAdmin() {
      // Чете собствения си user документ, за да провери ролята
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // -- Collections --
    // Потребители (само админ може да променя роли)
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // Членове
    match /members/{memberId} {
      allow read, write: if isAdmin();
      
      // ЗАЩИТА: Забрани изтриването, ако има активни/дължащи абонаменти
      // Забележка: Това изисква съществуването на колекция memberSubscriptions
      allow delete: if isAdmin() && !exists(/databases/$(database)/documents/memberSubscriptions?query.where('memberId', '==', memberId).where('status', 'in', ['active', 'pending_payment', 'overdue']));
    }

    // Услуги
    match /clubServices/{serviceId} {
      allow read: if isAuthenticated(); // Всеки логнат може да ги види
      allow create, update: if isAdmin() && 
                               request.resource.data.price > 0 && // ВАЛИДАЦИЯ: Цената е положителна
                               request.resource.data.name.size() > 3;
      allow delete: if isAdmin();
    }
    
    // Продукти (Инвентар)
    match /products/{productId} {
       allow read: if isAuthenticated();
       allow create, update, delete: if isAdmin() &&
                                        request.resource.data.price >= 0 && // Може да е 0, ако е подарък
                                        request.resource.data.stock >= 0; // Наличността не може да е отрицателна
    }

    // Абонаменти на членове
    match /memberSubscriptions/{subscriptionId} {
      allow read, write: if isAdmin();
      
      // ВАЛИДАЦИЯ: Платената цена не може да е отрицателна
      allow create, update: if isAdmin() && request.resource.data.pricePaid >= 0;
    }
    
    // Продажби
    match /sales/{saleId} {
      allow read, write: if isAdmin();

      // ВАЛИДАЦИЯ: Общата сума не може да е отрицателна
      allow create: if isAdmin() && request.resource.data.totalAmount > 0;
    }

    // Защита за всички останали пътища
    match /{document=**} {
      allow read, write: if false;
    }
  }
}