rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Позволява четене и писане в колекцията за абонаменти
    match /memberSubscriptions/{id} {
      allow read, write: if request.auth != null;
    }
    // Позволява за всички останали (членове, продажби и т.н.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}