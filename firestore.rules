rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This rule allows all authenticated users to read and write to all documents.
    // Crucially, it also allows server-side access via the Firebase Admin SDK,
    // which authenticates as a service account and is considered an 'authenticated' request.
    // This is the secure and correct replacement for the temporary 'if true;' rule.
    match /{document=**} {
      // Authenticated users can read for real-time dashboard updates via onSnapshot
      allow read: if request.auth != null;
      
      // All writes (create, update, delete) must be performed via Next.js Server Actions
      // which use the Firebase Admin SDK to bypass these rules securely.
      allow write: if false;
    }

  }
}
