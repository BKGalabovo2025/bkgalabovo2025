rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper Functions --
    function isAdmin() {
      // Read own user document to check role
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // -- Collections --
    // WARNING: This is insecure for production. Allows all reads and writes.
    // This is for local development and emulator use only.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}