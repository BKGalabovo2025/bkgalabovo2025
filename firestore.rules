rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Помощна функция за проверка на супер администратор
    function isSuperAdmin() {
      return request.auth != null && (request.auth.token.email == 'bkgalabovo2014@gmail.com' || request.auth.token.email == 'recoveryzonebyzm@gmail.com');
    }

    // Помощна функция за проверка на администратор
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || isSuperAdmin());
    }

    // Проверка за валиден идентификатор на сайта при създаване/редакция
    function hasValidSiteId() {
      return request.method in ['get', 'list', 'delete'] || 
             (request.resource.data.keys().hasAll(['siteId']) && 
              request.resource.data.siteId in ['bkgalabovo', 'recoveryzone']);
    }

    // Проверка дали потребителят има достъп до конкретния сайт според неговия Custom Claim (Multi-tenancy)
    function hasAccessToSite(siteId) {
      return request.auth != null && 
             (isSuperAdmin() || 
              request.auth.token.allowedSites == null || 
              (siteId != null && siteId in request.auth.token.allowedSites));
    }

    function checkResourceSiteAccess() {
      return isSuperAdmin() || (('siteId' in resource.data) ? hasAccessToSite(resource.data.siteId) : hasAccessToSite('bkgalabovo'));
    }

      // 1. Колекции с достъп за четене от логнати потребители и писане от админи със SiteId
      match /{collection}/{docId} {
        allow get: if request.auth != null && collection in [
          'members', 'clubServices', 'clubGeneralServices', 'memberSubscriptions', 
          'prices', 'priceHistory', 'events', 'exercises', 'member_assessments',
          'planner_sessions', 'beep_test_results', 'member_shadow_analytics',
          'training_attendance', 'focus_tags', 'member_declarations', 'marketing_history',
          'marketing_templates', 'marketing_automations',
          'business_trips', 'trip_expenses', 'annual_plans', 'training_templates',
          'feedback_templates', 'serviceHistory', 'generalServiceHistory',
          'certificate_templates'
        ] && checkResourceSiteAccess();

        allow list: if request.auth != null && collection in [
          'members', 'clubServices', 'clubGeneralServices', 'memberSubscriptions', 
          'prices', 'priceHistory', 'events', 'exercises', 'member_assessments',
          'planner_sessions', 'beep_test_results', 'member_shadow_analytics',
          'training_attendance', 'focus_tags', 'member_declarations', 'marketing_history',
          'marketing_templates', 'marketing_automations',
          'business_trips', 'trip_expenses', 'annual_plans', 'training_templates',
          'feedback_templates', 'serviceHistory', 'generalServiceHistory',
          'certificate_templates'
        ] && (isSuperAdmin() || request.auth.token.allowedSites == null || (resource.data.siteId in request.auth.token.allowedSites));

        allow create, update: if isAdmin() && hasValidSiteId() && collection in [
          'members', 'clubServices', 'clubGeneralServices', 'memberSubscriptions', 
          'prices', 'priceHistory', 'events', 'exercises', 'member_assessments',
          'planner_sessions', 'beep_test_results', 'member_shadow_analytics',
          'training_attendance', 'focus_tags', 'member_declarations', 'marketing_history',
          'marketing_templates', 'marketing_automations',
          'business_trips', 'trip_expenses', 'annual_plans', 'training_templates',
          'feedback_templates', 'serviceHistory', 'generalServiceHistory',
          'certificate_templates'
        ] && hasAccessToSite(request.resource.data.siteId);

        allow delete: if isAdmin() && collection in [
          'members', 'clubServices', 'clubGeneralServices', 'memberSubscriptions', 
          'prices', 'priceHistory', 'events', 'exercises', 'member_assessments',
          'planner_sessions', 'beep_test_results', 'member_shadow_analytics',
          'training_attendance', 'focus_tags', 'member_declarations', 'marketing_history',
          'marketing_templates', 'marketing_automations',
          'business_trips', 'trip_expenses', 'annual_plans', 'training_templates',
          'feedback_templates', 'serviceHistory', 'generalServiceHistory',
          'certificate_templates'
        ] && checkResourceSiteAccess();

        // 2. Колекции с достъп за четене и писане само от админи със SiteId
        allow read: if isAdmin() && collection in [
          'sales', 'products', 'inventoryEvents', 'inventory_events', 'inventory', 'finances',
          'client_packages', 'clients', 'reviews', 'config'
        ] && checkResourceSiteAccess();

        allow create, update: if isAdmin() && hasValidSiteId() && collection in [
          'sales', 'products', 'inventoryEvents', 'inventory_events', 'inventory', 'finances',
          'client_packages', 'clients', 'reviews', 'config'
        ] && hasAccessToSite(request.resource.data.siteId);

        allow delete: if isAdmin() && collection in [
          'sales', 'products', 'inventoryEvents', 'inventory_events', 'inventory', 'finances',
          'client_packages', 'clients', 'reviews', 'config'
        ] && checkResourceSiteAccess();

        // 3. Колекции за администратори без изискване за SiteId (глобални)
        allow read, write: if isAdmin() && collection in ['settings', 'families', 'audit_logs', 'email_logs'];

        // 4. Публично четене, писане от админи със SiteId
        allow read: if collection in ['sessions', 'tournaments', 'quizzes', 'theory_results', 'feedback_campaigns', 'certificates', 'sponsors'];
        allow create, update: if isAdmin() && hasValidSiteId() && collection in ['sessions', 'tournaments', 'quizzes', 'theory_results', 'feedback_campaigns', 'certificates', 'sponsors'] && hasAccessToSite(request.resource.data.siteId);
        allow delete: if isAdmin() && collection in ['sessions', 'tournaments', 'quizzes', 'theory_results', 'feedback_campaigns', 'certificates', 'sponsors'] && checkResourceSiteAccess();
        
        // 4.1. Прецизно публично обновяване на theory_results само при предаване на викторина от състезател
        allow update: if collection == 'theory_results' &&
          resource.data.status == 'SENT' &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.shareToken == resource.data.shareToken &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'autoScore', 'totalScore', 'tacticalAnswer', 'answers', 'status', 'submittedAt'
          ]);

        // 4.2. Публично създаване на отзиви (feedback_submissions) и четене на одобрените отзиви
        allow create: if collection == 'feedback_submissions';
        allow read: if (collection == 'feedback_submissions' && resource.data.status == 'approved' && resource.data.showInPublic == true) || (request.auth != null && collection == 'feedback_submissions' && checkResourceSiteAccess());
        allow update: if isAdmin() && collection == 'feedback_submissions';
        allow delete: if isAdmin() && collection == 'feedback_submissions';

        // 5. Публично четене, писане от админи без SiteId
        allow read: if collection == 'sites';
        allow write: if isAdmin() && collection == 'sites';

        // 6. Специфични за турнирите (четене от логнати, писане от админи без SiteId)
        allow read: if request.auth != null && collection in ['tournament_entries', 'tournament_matches'];
        allow write: if isAdmin() && collection in ['tournament_entries', 'tournament_matches'];
      }

    // Изрично позволени под-колекции (wildcard paths), защитаваме ги и тях със siteId
    match /{path=**}/reservations/{docId} {
      allow read: if request.auth != null && checkResourceSiteAccess();
      allow write: if isAdmin() && hasValidSiteId() && hasAccessToSite(request.resource.data.siteId);
    }

    match /{path=**}/blockedSlots/{docId} {
      allow read: if request.auth != null && checkResourceSiteAccess();
      allow write: if isAdmin() && hasValidSiteId() && hasAccessToSite(request.resource.data.siteId);
    }

    // Защита по подразбиране (отказва достъп за всичко останало)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
