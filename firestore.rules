rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Помощна функция за проверка на администратор
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'bkgalabovo2014@gmail.com');
    }

    // Всички документи в тези колекции са достъпни само за администратори
    match /members/{docId} { allow read, write: if isAdmin(); }
    match /sales/{docId} { allow read, write: if isAdmin(); }
    match /finances/{docId} { allow read, write: if isAdmin(); }
    match /inventory/{docId} { allow read, write: if isAdmin(); }

    // Резервациите могат да се четат от всеки влязъл, но се променят само от админ
    match /reservations/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Публична информация (турнири) - достъпна за четене от всички
    match /tournaments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Всичко останало е забранено по подразбиране
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

