rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Помощна функция за проверка на администратор
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'bkgalabovo2014@gmail.com');
    }

    // Проверка за валиден идентификатор на сайта (Multi-tenancy)
    function hasValidSiteId() {
      // При изтриване няма данни, затова разрешаваме. 
      // При създаване/обновяване изискваме наличие на siteId, който да е валиден.
      return request.method == 'delete' || 
             (request.resource.data.keys().hasAll(['siteId']) && 
             request.resource.data.siteId in ['bkgalabovo', 'recoveryzone']);
    }

    // Всички документи в тези колекции са достъпни само за администратори
    match /members/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /sales/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /finances/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /inventory/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }

    // Резервациите могат да се четат от всеки влязъл, но се променят само от админ
    match /{path=**}/reservations/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && hasValidSiteId();
    }

    // Публична информация (турнири) - достъпна за четене от всички
    match /tournaments/{docId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidSiteId();
    }

    // Всичко останало е забранено по подразбиране
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

