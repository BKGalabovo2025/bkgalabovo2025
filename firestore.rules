rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Помощна функция за проверка на администратор
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'bkgalabovo2014@gmail.com');
    }

    // Проверка за валиден идентификатор на сайта (Multi-tenancy)
    function hasValidSiteId() {
      // При изтриване няма данни, затова разрешаваме. 
      // При създаване/обновяване изискваме наличие на siteId, който да е валиден.
      return request.method == 'delete' || 
             (request.resource.data.keys().hasAll(['siteId']) && 
             request.resource.data.siteId in ['bkgalabovo', 'recoveryzone']);
    }

    // Всички документи в тези колекции са достъпни само за администратори
    match /members/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /sales/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /products/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /inventoryEvents/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /clubServices/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /memberSubscriptions/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /finances/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /inventory/{docId} { allow read: if isAdmin(); allow write: if isAdmin() && hasValidSiteId(); }
    match /settings/{docId} { allow read, write: if isAdmin(); }
    match /families/{docId} { allow read, write: if isAdmin(); }
    
    // Колекции от Recovery Zone
    match /client_packages/{docId} { allow read, write: if isAdmin() && hasValidSiteId(); }
    match /clients/{docId} { allow read, write: if isAdmin() && hasValidSiteId(); }
    match /reviews/{docId} { allow read, write: if isAdmin() && hasValidSiteId(); }
    match /sessions/{docId} { 
      allow read: if true; 
      allow write: if isAdmin() && hasValidSiteId(); 
    }
    match /config/{docId} { allow read, write: if isAdmin() && hasValidSiteId(); }

    // График и събития - четене от влезли, промяна от админ
    match /events/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && hasValidSiteId();
    }

    match /{path=**}/reservations/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && hasValidSiteId();
    }

    match /{path=**}/blockedSlots/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && hasValidSiteId();
    }

    // Публична информация (турнири и сайтове) - достъпна за четене от всички
    match /tournaments/{docId} {
      allow read: if true;
      allow write: if isAdmin() && hasValidSiteId();
    }

    match /tournament_entries/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /tournament_matches/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /sites/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Всичко останало е забранено по подразбиране
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

