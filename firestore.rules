rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Позволяваме всичко на логнати потребители за тези конкретни колекции
    match /memberSubscriptions/{id} { allow read, write: if request.auth != null; }
    match /sales/{id} { allow read, write: if request.auth != null; }
    match /members/{id} { allow read, write: if request.auth != null; }
    
    // Глобално за останалите
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}