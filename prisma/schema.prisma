
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Defines a user account
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Defines a user session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Defines a user
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  events        InventoryEvent[] // A user can perform many inventory events
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------
// --- INVENTORY MODELS START HERE ---
// ------------------------------------

// Represents a single product in the inventory
model Product {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String    @unique
  category    String
  quantity    Int       @default(0)
  price       Float
  
  // Relation to inventory events
  events      InventoryEvent[]
}

// Represents a single event in the inventory history (e.g., restock, price change)
model InventoryEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  type        String   // e.g., "RESTOCK", "PRICE_UPDATE", "SALE"
  quantityChange Int?  // For RESTOCK (+ve) and SALE (-ve)
  oldPrice    Float?   // For PRICE_UPDATE
  newPrice    Float?   // For PRICE_UPDATE
  notes       String?  // Optional notes for the event

  // Relation to the product
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Relation to the user who performed the action
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}
