{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/app/api/**/*.ts", "src/app/**/*.tsx", "scripts/**/*.ts"],
  "ignore": [],
  "ignoreDependencies": [
    "tsconfig-paths",
    "autoprefixer",
    "eslint-config-prettier",
    "lint-staged",
    "@tailwindcss/postcss",
    "postcss-load-config",
    "husky"
  ],
  "ignoreBinaries": ["lint-staged", "husky"],
  "next": {
    "entry": ["src/app/api/**/*.ts", "src/app/**/*.tsx"]
  }
}
