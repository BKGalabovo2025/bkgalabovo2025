{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/api/**/*.ts",
    "src/app/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": [
    "scripts/**/*.cjs",
    "scripts/**/*.mjs",
    "src/components/ui/calendar.tsx",
    "src/components/documents/DocumentLegalText.tsx",
    "public/vendor/pdfjs/**"
  ],
  "ignoreDependencies": [
    "stylelint-config-tailwindcss",
    "@storybook/nextjs",
    "react-day-picker"
  ],
  "ignoreBinaries": ["netstat", "findstr"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  },
  "next": {
    "entry": ["src/app/api/**/*.ts", "src/app/**/*.tsx"]
  }
}
