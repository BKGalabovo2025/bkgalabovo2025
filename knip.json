{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/api/**/*.ts",
    "src/app/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": ["scripts/**/*.cjs", "scripts/**/*.mjs"],
  "ignoreDependencies": ["stylelint-config-tailwindcss", "@storybook/nextjs"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  },
  "next": {
    "entry": ["src/app/api/**/*.ts", "src/app/**/*.tsx"]
  }
}
